.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
# Scratch output from a `pyright --outputjson` run, not a project document.
pyright_out.json
data/
run/
backups/
# WebView2's profile/cache. Frozen builds put this under ProgramData; running
# from source it lands next to the repo.
webview/
deployment.json
# Where the shop PC checks online for new releases; may hold a repo token.
update_source.json
*.pyc
# Runtime note of the chosen USB mirror target, written next to the DB.
backup_destination.json
# Installers dropped in for the shop PC to hand out. Frozen builds keep these
# under ProgramData; running from source they land next to the repo, and a
# 40 MB setup exe is not something to commit.
updates/
build/
dist/
# Fetched by build_installer.ps1 at build time, not ours to vendor.
installers/MicrosoftEdgeWebview2Setup.exe
*.spec
# ...but THIS spec is the build definition, not a throwaway: it carries the
# onefile mode, the bundled static/, and the exe icon. Losing it loses the build.
!RECON.spec
*.log
# ...but the automated improvement run's changelog is a tracked project
# document, not a throwaway runtime log.
!auto_improvements.log

# jsdom for the optional front-end smoke test (tests/dom)
tests/dom/node_modules/
tests/dom/package-lock.json
tests/dom/package.json
